rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Empresa a la que pertenece quien sube (se lee del SERVIDOR, no del navegador).
    function miEmpresa() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.empresaId;
    }

    // Archivos de cada empresa: fotos de productos y logo. Cada empresa solo entra a SU carpeta.
    // Las URL que devuelve getDownloadURL llevan un token y siguen funcionando en tickets y PDF.
    match /empresas/{empresaId}/{carpeta}/{archivo} {
      allow read: if request.auth != null && miEmpresa() == empresaId;
      allow write: if request.auth != null
        && miEmpresa() == empresaId
        && carpeta in ['productos', 'logos']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && miEmpresa() == empresaId;
    }

    // Todo lo demás (p. ej. fotos de marcación de asistencia) lo sube SOLO el backend
    // (Cloud Function `marcar`, Admin SDK, que se salta estas reglas). Nadie del cliente
    // lee ni escribe directo; la URL guardada en 'marcaciones' lleva su propio token.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
