rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /contribuyentes_prueba/{id} {
      allow read, write: if esAdmin();
    }

    // ── HELPERS ──────────────────────────────────────────────
    function logueado() {
      return request.auth != null;
    }

    function esEmpleadoPIN() {
      return logueado()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(/databases/$(database)/documents/sesiones_empleado/$(request.auth.uid));
    }

    function misDatos() {
      return esEmpleadoPIN()
        ? get(/databases/$(database)/documents/sesiones_empleado/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function puede(permiso) {
      return logueado() && permiso in misDatos().permisos;
    }

    function esAdmin() {
      return logueado() && misDatos().rol == 'administrador';
    }

    // Cajeros y vendedores ven SOLO sus propias ventas/facturas (las que tienen
    // su uid en cajeroId). Admin y demás roles (contador, etc.) ven todas las de
    // la empresa. El frontend filtra la query por cajeroId para estos roles.
    function soloVeLoPropio() {
      return logueado() && (misDatos().rol == 'cajero' || misDatos().rol == 'vendedor');
    }

    // ── SESIONES DE EMPLEADO (legacy) ────────────────────────
    // El login de empleados ahora usa CUSTOM TOKEN (uid = id del doc 'usuarios'),
    // así misDatos() lee el doc real, no falsificable. Esta colección quedó
    // obsoleta: NADIE puede escribir/leer (evita falsificar permisos). misDatos()
    // sigue leyéndola con get() (se salta esta regla) solo para sesiones antiguas
    // aún activas, hasta que esos empleados vuelvan a loguear.
    match /sesiones_empleado/{authUid} {
      allow read, write: if false;
    }

    // Contador anti fuerza bruta del login de empleados. Solo lo toca la
    // Cloud Function login-empleado (Admin SDK, se salta estas reglas).
    match /login_intentos/{usuario} {
      allow read, write: if false;
    }

    // ── COLECCIONES ──────────────────────────────────────────
    // Toda creación desde el cliente exige estar logueado Y que el documento
    // nazca con el empresaId DEL PROPIO usuario. Antes varias colecciones tenían
    // 'allow create: if true', lo que dejaba escribir a cualquiera desde internet
    // (sin cuenta) en la empresa que quisiera.
    function creaEnMiEmpresa() {
      return logueado() && request.resource.data.empresaId == misDatos().empresaId;
    }

    // El documento existente es de mi empresa (para update/delete).
    function esDeMiEmpresa() {
      return logueado() && resource.data.empresaId == misDatos().empresaId;
    }

    function soloCambiaStock() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    // Helper: ¿solo se actualiza un correlativo? (no toca otros campos sensibles)
    // Usado para que el módulo Operaciones pueda incrementar correlativo_NR/correlativo_FSE
    // sin necesitar el permiso completo de editar_configuracion.
    function soloCambiaCorrelativo() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['correlativo_NR', 'correlativo_FSE', 'correlativo_FE', 'correlativo_CCF', 'correlativo_NC', 'correlativo_ND', 'correlativo_FEX', 'correlativo_Retencion']);
    }

    // Campos que un usuario de la empresa (NO maestro) puede modificar en su
    // configuracion: cosméticos, requerirCaja y correlativos. Los datos FISCALES
    // (nit, nombre, actividad, codEstable, etc.) solo los toca One Geo (SuperAdmin).
    function soloCamposCliente() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'empresaSlogan', 'nombreComercial', 'logoUrl', 'colorPrimario', 'telefono', 'correo',
        'requerirCaja', 'updatedAt',
        'correlativo_NR', 'correlativo_FSE', 'correlativo_FE', 'correlativo_CCF',
        'correlativo_NC', 'correlativo_ND', 'correlativo_FEX', 'correlativo_Retencion'
      ]);
    }

    // Una venta en el POS incrementa el correlativo (numeroDte local) de SU
    // sucursal. Permitimos que un usuario de la empresa cambie SOLO esos campos
    // (los códigos MH y el resto siguen siendo exclusivos de One Geo).
    function soloCambiaCorrelativoSucursal() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['correlativoFE', 'correlativoCCF', 'correlativoNC', 'correlativoND', 'correlativoFEX']);
    }

    match /productos/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa()
        && (puede('crear_productos') || puede('editar_productos') || esAdmin());
      allow update: if esDeMiEmpresa()
        && request.resource.data.empresaId == misDatos().empresaId
        && (puede('editar_productos') || esAdmin()
            || (soloCambiaStock() && (puede('realizar_ventas') || puede('registrar_movimientos'))));
      allow delete: if esDeMiEmpresa() && (puede('eliminar_productos') || esAdmin());
    }
    match /ventas/{id} {
      allow read: if logueado() && (
        (resource.data.empresaId == misDatos().empresaId
          && (!soloVeLoPropio() || resource.data.cajeroId == request.auth.uid))
        || (resource.data._certificacion == true && esMaestroOneGeo())
      );
      // El maestro también crea ventas de PRUEBA bajo la empresa que certifica
      // (Asistente de Certificación), por eso se le permite cualquier empresaId.
      allow create: if esMaestroOneGeo() || creaEnMiEmpresa();
      allow update, delete: if esDeMiEmpresa() && (puede('cancelar_ventas') || esAdmin());
    }
    match /facturas/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId
        && (!soloVeLoPropio() || resource.data.cajeroId == request.auth.uid);
      allow create: if esMaestroOneGeo() || creaEnMiEmpresa();
      allow update: if esDeMiEmpresa() && (puede('editar_facturas') || esAdmin());
      allow delete: if esDeMiEmpresa() && (puede('eliminar_facturas') || esAdmin());
    }
    match /clientes/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa();
      allow update: if esDeMiEmpresa() && (puede('editar_clientes') || esAdmin());
      allow delete: if esDeMiEmpresa() && (puede('eliminar_clientes') || esAdmin());
    }
    match /compras/{id} {
      allow read: if (puede('ver_compras') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa() && (puede('crear_compras') || esAdmin());
      allow update: if esDeMiEmpresa() && (puede('editar_compras') || esAdmin());
      allow delete: if esDeMiEmpresa() && (puede('eliminar_compras') || esAdmin());
    }
    // Proveedores: usados por Compras Y por FSE (módulo Operaciones).
    // Por eso ampliamos los permisos a quien puede facturar también.
    match /proveedores/{id} {
      allow read: if (puede('ver_compras') || puede('ver_facturas') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa()
        && (puede('crear_compras') || puede('crear_facturas') || esAdmin());
      allow update, delete: if esDeMiEmpresa()
        && (puede('crear_compras') || puede('crear_facturas') || esAdmin());
    }
    match /cotizaciones/{id} {
      allow read: if (puede('ver_cotizaciones') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa() && (puede('crear_cotizaciones') || esAdmin());
      allow update: if esDeMiEmpresa() && (puede('editar_cotizaciones') || esAdmin());
      allow delete: if esDeMiEmpresa() && (puede('eliminar_cotizaciones') || esAdmin());
    }
    match /kardex/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa();
      allow update, delete: if false;
    }
    match /bodegas/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa() && (puede('editar_productos') || esAdmin());
      allow update, delete: if esDeMiEmpresa() && (puede('editar_productos') || esAdmin());
    }
    match /sucursales/{id} {
      allow read: if logueado() && (resource.data.empresaId == misDatos().empresaId || esMaestroOneGeo());
      allow create, delete: if esMaestroOneGeo();
      allow update: if esMaestroOneGeo()
        || (logueado() && resource.data.empresaId == misDatos().empresaId && soloCambiaCorrelativoSucursal());
    }
    match /categorias/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa() && (puede('editar_productos') || esAdmin());
      allow update, delete: if esDeMiEmpresa() && (puede('editar_productos') || esAdmin());
    }
    match /cajas/{id} {
      allow read: if logueado() && resource.data.empresaId == misDatos().empresaId;
      allow create: if creaEnMiEmpresa();
      allow update: if esDeMiEmpresa() && request.resource.data.empresaId == misDatos().empresaId;
      allow delete: if false;
    }
    match /usuarios/{id} {
      // El doc 'usuarios' guarda el PIN de login del empleado. Cada quien lee SU
      // propio doc (por uid o por email, lo necesita el login y los permisos);
      // pero la LISTA de la empresa solo la leen admin o quien tenga
      // 'ver_usuarios'. Antes cualquier empleado leía todos los docs de su
      // empresa → un cajero podía sacar el usuario+PIN de sus compañeros desde la
      // consola y hacerse pasar por ellos.
      allow read: if logueado() && (
        request.auth.uid == id
        || resource.data.email == request.auth.token.email
        || ((esAdmin() || puede('ver_usuarios') || puede('editar_usuarios'))
            && resource.data.empresaId == misDatos().empresaId)
      );
      // Crear: SOLO un admin dando de alta un usuario DE SU empresa, o el maestro.
      // Antes se permitía 'request.auth.uid == id' (auto-crearse el perfil), lo que
      // dejaba a cualquiera registrarse y fabricarse un doc con rol 'administrador'
      // y el empresaId de otro cliente → acceso total a esa empresa. El alta real
      // la hace la Cloud Function gestionar-admin (Admin SDK, se salta las reglas).
      allow create: if esMaestroOneGeo()
        || ((esAdmin() || puede('editar_usuarios')) && request.resource.data.empresaId == misDatos().empresaId);
      // Actualizar: admin o 'editar_usuarios', de la misma empresa. PERO cambiar
      // 'rol' o 'permisos' es SOLO de admin: si no, alguien con 'editar_usuarios'
      // podría editar su propio doc y ascenderse a administrador (escalada de
      // privilegios dentro de la empresa).
      allow update: if (esAdmin() || puede('editar_usuarios'))
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId
        && (esAdmin() || (
              request.resource.data.rol == resource.data.rol
              && request.resource.data.permisos == resource.data.permisos
           ));
      allow delete: if (esAdmin() || puede('eliminar_usuarios'))
        && resource.data.empresaId == misDatos().empresaId;
    }
    // Configuración: los DATOS FISCALES los escribe solo One Geo (maestro). El
    // cliente solo puede tocar campos no-fiscales (cosméticos, requerirCaja,
    // correlativos) de SU empresa. Lectura: su propia config, el doc 'global'
    // (flag de certificación) o el maestro (que ve todas para gestionarlas).
    match /configuracion/{id} {
      allow read: if logueado() && (id == misDatos().empresaId || id == 'global' || esMaestroOneGeo());
      allow write: if esMaestroOneGeo()
        || (logueado() && id == misDatos().empresaId && soloCamposCliente());
    }
    // Los eventos de invalidación los escribe SOLO el backend (invalidar.js con
    // Admin SDK, que se salta estas reglas). El cliente nunca los crea.
    match /eventos_invalidacion/{id} {
      allow read: if (puede('ver_facturas') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId;
      allow create, update, delete: if false;
    }
    // Operaciones: NR (Notas de Remisión) y FSE (Facturas Sujeto Excluido).
    // Quien puede facturar también puede crear y ver operaciones.
    // El estado se actualiza desde el backend al transmitir al MH.
    match /operaciones/{id} {
      allow read: if (puede('ver_facturas') || esAdmin()) && resource.data.empresaId == misDatos().empresaId
        && (!soloVeLoPropio() || resource.data.cajeroId == request.auth.uid);
      allow create: if esMaestroOneGeo() || (creaEnMiEmpresa() && (puede('crear_facturas') || esAdmin()));
      allow update: if esDeMiEmpresa() && (puede('editar_facturas') || esAdmin());
      allow delete: if esDeMiEmpresa() && (puede('eliminar_facturas') || esAdmin());
    }

    // ── EMPLEADOS (RR.HH. — módulo Asistencia + Planilla) ────
    // Datos sensibles (sueldos, AFP, ISSS, PIN de marcación): SOLO admin o quien
    // tenga 'gestionar_personal', y de SU empresa. Los empleados NUNCA leen esta
    // colección (el PIN se validará server-side por Cloud Function en la marcación).
    match /empleados/{id} {
      allow read: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if (puede('gestionar_personal') || esAdmin()) && request.resource.data.empresaId == misDatos().empresaId;
      allow update: if (puede('gestionar_personal') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId;
      allow delete: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
    }

    // ── MARCACIONES (asistencia) — las escribe SOLO el backend ──
    // La Cloud Function `marcar` (Admin SDK) crea las marcas con hora del
    // servidor. NADIE las crea/edita desde el cliente → no se pueden falsificar.
    // Lectura: admin / gestionar_personal de la propia empresa (para reportes).
    match /marcaciones/{id} {
      allow read: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      // Crear: SOLO el backend (Cloud Function). Corregir errores del empleado: el
      // dueño puede RE-ETIQUETAR (entrada↔salida) o ANULAR una marca de SU empresa
      // — la HORA y la FOTO no se pueden alterar (hasOnly).
      allow create: if false;
      allow update: if (puede('gestionar_personal') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipo', 'corregido', 'corregidoPor', 'updatedAt']);
      allow delete: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
    }

    // ── JUSTIFICACIONES (asistencia) ─────────────────────────
    // El dueño / gestionar_personal justifica un día de un empleado (categoría +
    // detalle + "¿se paga?"). Alimenta la planilla (Etapa 4). Solo su empresa.
    match /justificaciones/{id} {
      allow read: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if (puede('gestionar_personal') || esAdmin()) && request.resource.data.empresaId == misDatos().empresaId;
      allow update: if (puede('gestionar_personal') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId;
      allow delete: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
    }

    // ── NÓMINA CONFIG (descuentos de ley, editable por el dueño) ──
    // Doc por empresa (id == empresaId) con los %/topes de ISSS, AFP, etc.
    match /nomina_config/{id} {
      allow read, write: if (puede('gestionar_personal') || esAdmin()) && id == misDatos().empresaId;
    }

    // ── AJUSTES DE PLANILLA (bono / descuento / adelanto por período) ──
    match /nomina_ajustes/{id} {
      allow read: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if (puede('gestionar_personal') || esAdmin()) && request.resource.data.empresaId == misDatos().empresaId;
      allow update: if (puede('gestionar_personal') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId;
      allow delete: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
    }

    // ── DÍAS NO LABORABLES (asueto / vacación / cierre — general a toda la empresa) ──
    match /dias_no_laborables/{id} {
      allow read: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
      allow create: if (puede('gestionar_personal') || esAdmin()) && request.resource.data.empresaId == misDatos().empresaId;
      allow update: if (puede('gestionar_personal') || esAdmin())
        && resource.data.empresaId == misDatos().empresaId
        && request.resource.data.empresaId == misDatos().empresaId;
      allow delete: if (puede('gestionar_personal') || esAdmin()) && resource.data.empresaId == misDatos().empresaId;
    }

    // ── EMPRESAS (multi-empresa) ─────────────────────────────
    // Colección maestra de clientes de ORIÓN. Solo el usuario maestro de
    // One Geo (correo autorizado) puede crear/editar/eliminar empresas.
    // La lectura se permite a usuarios logueados (más adelante, cuando se
    // implemente el filtrado por empresaId, se restringe a la empresa propia).
    function esMaestroOneGeo() {
      return logueado()
        && request.auth.token.email in [
          'arnoldomartinez3@gmail.com'
        ];
    }
    // Cada usuario lee SOLO la ficha de su propia empresa. El maestro las ve todas
    // (Panel One Geo / Asistente de Certificación). Antes era 'if logueado()', que
    // exponía la cartera completa de clientes de ORIÓN a cualquier usuario.
    match /empresas/{id} {
      allow read: if logueado() && (esMaestroOneGeo() || id == misDatos().empresaId);
      allow create, update, delete: if esMaestroOneGeo();
    }

    // ── CONTADORES (correlativos de DTE) ─────────────────────
    // Normalmente los escribe el BACKEND (transmitir.js con Admin SDK, que
    // se salta estas reglas). El permiso de escritura aquí es solo para que
    // el maestro de One Geo pueda recrearlos/ajustarlos desde el panel
    // (herramienta de mantenimiento). Un cliente normal nunca los toca.
    // Los correlativos oficiales los maneja el BACKEND (transmitir.js, Admin SDK).
    // Desde el cliente solo los consulta el maestro (mantenimiento en SuperAdmin);
    // antes cualquier usuario logueado podía leer los volúmenes de otras empresas.
    match /contadores/{id} {
      allow read, write: if esMaestroOneGeo();
    }

    // ── SECRETOS MH (certificado + credenciales) ─────────────
    // NADIE del frontend puede leer/escribir esto. Solo el backend
    // (Admin SDK) que se salta estas reglas. Protege el certificado_pem
    // y las credenciales MH de ser leídos desde la consola del navegador.
    match /secretos_mh/{id} {
      allow read, write: if false;
    }

  }
}
