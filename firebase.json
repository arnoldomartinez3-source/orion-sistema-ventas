{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/dte/transmitir",
        "function": "transmitir"
      },
      {
        "source": "/api/dte/invalidar",
        "function": "invalidar"
      },
      {
        "source": "/api/dte/contingencia",
        "function": "contingencia"
      },
      {
        "source": "/api/dte/crear-admin",
        "function": "crearAdmin"
      },
      {
        "source": "/api/dte/gestionar-admin",
        "function": "gestionarAdmin"
      },
      {
        "source": "/api/login-empleado",
        "function": "loginEmpleado"
      },
      {
        "source": "/api/marcar",
        "function": "marcar"
      },
      {
        "source": "/api/dte/enviar-factura",
        "function": "enviarFactura"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
